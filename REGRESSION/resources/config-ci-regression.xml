<globalTestConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                         xmlns="http://www.testlum.com/testing/model/global-config"
                         xsi:schemaLocation="http://www.testlum.com/testing/model/global-config global-config.xsd">

    <parallelExecution>false</parallelExecution>
    <stopScenarioOnFailure>false</stopScenarioOnFailure>
    <stopIfInvalidScenario>true</stopIfInvalidScenario>
    <delayBetweenScenarioRuns seconds="1" enabled="true"/>

    <runScenariosByTag enabled="true">
        <tag name="end2end" enabled="true"/>

        <!--    UI    -->
        <tag name="web" enabled="true"/>
        <tag name="mobilebrowser" enabled="false"/>
        <tag name="mobilebrowser-healthcheck" enabled="false"/>
        <tag name="native" enabled="false"/>
        <tag name="native-webview" enabled="false"/>
        <tag name="native-healthcheck" enabled="false"/>

        <!--    General    -->
        <tag name="condition" enabled="true"/>
        <tag name="assert" enabled="true"/>
        <tag name="var" enabled="true"/>
        <tag name="variations" enabled="true"/>
        <tag name="repeat" enabled="true"/>
        <tag name="migrate" enabled="true"/>
        <tag name="include" enabled="true"/>
        <tag name="wait" enabled="true"/>

        <!--    API    -->
        <tag name="http" enabled="true"/>
        <tag name="websocket" enabled="true"/>
        <tag name="graphql" enabled="true"/>
        <tag name="auth-basic-mixed" enabled="true"/>
        <tag name="auth-jwt-mixed" enabled="true"/>

        <!--    Databases    -->
        <tag name="mysql" enabled="true"/>
        <tag name="postgres" enabled="true"/>
        <tag name="clickhouse" enabled="false"/>
        <tag name="oracle" enabled="true"/>
        <tag name="mongodb" enabled="true"/>
        <tag name="redis" enabled="true"/>
        <tag name="abstract-db" enabled="true"/>

        <!--    AWS    -->
        <tag name="dynamodb" enabled="true"/>
        <tag name="ses" enabled="true"/>
        <tag name="sqs" enabled="true"/>
        <tag name="s3" enabled="true"/>
        <tag name="lambda" enabled="true"/>

        <!--    Queues    -->
        <tag name="kafka" enabled="true"/>
        <tag name="rabbit" enabled="true"/>

        <!--    Messaging    -->
        <tag name="sendgrid" enabled="false"/>
        <tag name="twilio" enabled="false"/>
        <tag name="smtp" enabled="true"/>

        <!--    Other    -->
        <tag name="shell" enabled="true"/>
        <tag name="shell-windows" enabled="false"/>
        <tag name="elasticsearch" enabled="true"/>
    </runScenariosByTag>

    <report>
        <extentReports projectName="testlum-professional-subscription">
            <htmlReportGenerator enabled="true"/>
            <klovServerReportGenerator enabled="false">
                <mongoDB host="192.168.0.10" port="27017"/>
                <klovServer url="https://reports.knubisoft.com"/>
            </klovServerReportGenerator>
        </extentReports>
    </report>

    <environments>
        <env folder="ci" enabled="true" threads="1"/>
    </environments>

    <vault>
        <host>vault-e2e</host>
        <port>8200</port>
        <scheme>http</scheme>
        <token>myroot</token>
    </vault>

</globalTestConfiguration>