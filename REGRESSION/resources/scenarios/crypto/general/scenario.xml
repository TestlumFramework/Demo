<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <description>
            General test for Crypto command.
            Covers encryption, decryption, variables, special characters,
            unicode and conditional execution.
        </description>
        <name>Crypto general test</name>
    </overview>

    <settings>
        <tags>crypto</tags>
    </settings>

    <var comment="Plain text"
         name="plainText">
        <constant value="'dota DOTA2'"/>
    </var>

    <crypto action="encrypt"
            alias="CRYPTO2"
            comment="Encrypt plain text"
            name="encryptedValue">
        <value>
            {{plainText}}
        </value>
    </crypto>

    <assert comment="Encrypted value must differ from plain text">
        <notEqual comment="Check not equal">
            <content>{{plainText}}</content>
            <content>{{encryptedValue}}</content>
        </notEqual>
    </assert>

    <crypto action="decrypt"
            alias="CRYPTO2"
            comment="Decrypt encrypted value"
            name="decryptedValue">
        <value>
            {{encryptedValue}}
        </value>
    </crypto>

    <assert comment="Decrypted value must equal original">
        <equal comment="Check equal">
            <content>{{plainText}}</content>
            <content>{{decryptedValue}}</content>
        </equal>
    </assert>


    <var comment="Special characters"
         name="specialText">
        <constant value="'Hello_Test-123! @#$%^&amp;*()[]{}+=:;,.?/|~`'"/>
    </var>

    <crypto action="encrypt"
            alias="CRYPTO2"
            comment="Encrypt special characters"
            name="encryptedSpecial">
        <value>
            {{specialText}}
        </value>
    </crypto>

    <crypto action="decrypt"
            alias="CRYPTO2"
            comment="Decrypt special characters"
            name="decryptedSpecial">
        <value>
            {{encryptedSpecial}}
        </value>
    </crypto>

    <assert comment="Special characters must survive encryption and decryption">
        <equal comment="Check equal">
            <content>{{specialText}}</content>
            <content>{{decryptedSpecial}}</content>
        </equal>
    </assert>

    <var comment="Unicode text"
         name="unicodeText">
        <constant value="'Привет Testlum 你好 🚀'"/>
    </var>

    <crypto action="encrypt"
            alias="CRYPTO2"
            comment="Encrypt unicode text"
            name="encryptedUnicode">
        <value>
            {{unicodeText}}
        </value>
    </crypto>

    <crypto action="decrypt"
            alias="CRYPTO2"
            comment="Decrypt unicode text"
            name="decryptedUnicode">
        <value>
            {{encryptedUnicode}}
        </value>
    </crypto>

    <assert comment="Unicode must survive encryption and decryption">
        <equal comment="Check equal">
            <content>{{unicodeText}}</content>
            <content>{{decryptedUnicode}}</content>
        </equal>
    </assert>

    <condition comment="Crypto execution is enabled"
               name="CRYPTO_ENABLED"
               spel="true"/>

    <crypto action="encrypt"
            alias="CRYPTO2"
            comment="Conditional encryption"
            condition="CRYPTO_ENABLED"
            name="conditionalEncrypted">
        <value>
            {{plainText}}
        </value>
    </crypto>

    <crypto action="decrypt"
            alias="CRYPTO2"
            comment="Conditional decryption"
            condition="CRYPTO_ENABLED"
            name="conditionalDecrypted">
        <value>
            {{conditionalEncrypted}}
        </value>
    </crypto>

    <assert comment="Conditional crypto must execute"
            condition="CRYPTO_ENABLED">
        <equal  comment="Check equal">
            <content>{{plainText}}</content>
            <content>{{conditionalDecrypted}}</content>
        </equal>
    </assert>

    <condition comment="Crypto execution is disabled"
               name="CRYPTO_DISABLED"
               spel="false"/>

    <crypto action="encrypt"
            alias="CRYPTO2"
            comment="Encryption must be skipped"
            condition="CRYPTO_DISABLED"
            name="skippedEncrypted">
        <value>
            {{plainText}}
        </value>
    </crypto>

    <assert comment="Assertion must be skipped when condition is false"
            condition="CRYPTO_DISABLED">
        <equal comment="Check equal">
            <content>wrong</content>
            <content>value</content>
        </equal>
    </assert>

</scenario>