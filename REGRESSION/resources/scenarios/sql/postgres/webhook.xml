<?xml version="1.0" encoding="UTF-8" ?>
<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.knubisoft.com/testlum/testing/model/scenario"
          xsi:schemaLocation="http://www.knubisoft.com/testlum/testing/model/scenario scenario.xsd">>

    <overview>
        <description>WebHook</description>
        <name>WebHook Test</name>
    </overview>

    <settings>
        <tags>webhook</tags>
    </settings>

    <webhook alias="WEBHOOK_0"
             comment="Check order-created webhook"
             path="/order-created"
             method="POST"
             timeout="15s"
             file="expected_order_created.json"/>

    <webhook forward="true" timeout="30s">
        <expected file="expected.json"/>
        <response stub="modified_or_stub.json"/>
    </webhook>

    <webhookNotReceiver timeout="30ms"/>




    <webhookSession path="/events"
                    method="POST"
                    duration="2m"
                    minRequests="1"
                    maxRequests="unbounded">

        <expected file="expected.json"/>

        <responseSequence>
            <response status="500" stub="error.json"/>
            <response status="500" stub="error.json"/>
            <response status="200" stub="success.json"/>
        </responseSequence>
    </webhookSession>




    <webhookSession path="/events"
                    method="POST"
                    receiveTimeout="30s"
                    quietPeriod="25s"
                    maxDuration="3m">

        <expected file="expected.json"/>

        <responses repeatLast="true">
            <response status="500" stub="error.json"/>
            <response delay="25s" status="200" stub="success.json"/>
        </responses>
    </webhookSession>

<!--
receiveTimeout="30s" — скільки чекати перший webhook;
quietPeriod="25s" — якщо протягом 25s немає нових webhook-ів, вважаємо серію завершеною;
maxDuration="3m" — hard stop, щоб не зависнути.

response delay - Testlum має вміти не відповідати одразу або затримувати відповідь.
-->


    <webhookSession method="POST"
                    path="/events"
                    forward="true"
                    receiveTimeout="30s"
                    quietPeriod="25s"
                    maxDuration="3m"
                    minRequests="2">

        <expected file="expected_webhook_request.json"/>

        <destinationResponses repeatLast="false">
            <expected status="201" file="destination_response_1.json"/>
            <expected status="200" file="destination_response_2.json"/>
        </destinationResponses>

        <senderResponses repeatLast="true">
            <response status="500" stub="sender_error.json"/>
            <response status="200" stub="sender_success.json"/>
        </senderResponses>
    </webhookSession>

    <webhook timeout="30s"
             forward="true"
             file="expected.json"
             response="modified_or_stub.json"/>


<!--    1-->

    <webhookSession timeout="60s">

        <webhook forward="true">
            <receive expected="expected.json"/>
            <response expected="response.json" stub="modified_or_stub.json"/>
        </webhook>

        <retry count="3" timeout="20s"> <!-- або unbounded -->
            <webhook forward="false">
                <receive expected="expected.json"/>
                <response expected="retry_response.json" stub="modified_or_stub.json"/>
            </webhook>
        </retry>


    </webhookSession>

<!--    2-->

    <webhookSession timeout="60s">

        <webhook>
            <receive expected="expected.json" forwardTo="API_WEBSITE_1"/>
            <response expected="response.json" return="modified_or_stub.json"/>
        </webhook>

        <retry min="3" max="5" idleTimeout="20s"> <!-- або times замість min/max -->
            <webhook>
                <receive expected="expected.json" forwardTo="API_WEBSITE_1"/>
                <response expected="retry_response.json" return="modified_or_stub.json"/>
            </webhook>
        </retry>

        <noRetry timeout="20s"/> <!-- зачекати й перевірити що retry не прийшов -->
        <!--        або retry times="0"-->


    </webhookSession>

<!--    3-->

        <webhook timeout="60s">
            <receive expected="payment_event.json" forward="true" alias="PAYMENT_API"/>
            <response expected="payment_created.json">
                    <mock file="mock.json" status="500">

                    </mock>
            </response>

            <retry min="1" max="5" idleTimeout="20s">
                <receive expected="payment_event.json" forwardTo="PAYMENT_API"/>
                <response expected="payment_already_processed.json" return="success.json"/>
            </retry>

            <noRetry timeout="20s"/>
        </webhook>



        <webhook timeout="60s">
            <receive expected="payment_event.json" forwardTo="PAYMENT_API"/>
            <response expected="payment_created.json" return="temporary_error.json"/>

            <retry idleTimeout="20s">
                <attempt>
                    <receive expected="retry_1_request.json" forwardTo="API_WEBSITE_1"/>
                    <response expected="retry_1_response.json" return="error.json"/>
                </attempt>

                <attempt>
                    <receive expected="retry_2_request.json" forwardTo="API_WEBSITE_1"/>
                    <response expected="retry_2_response.json" return="success.json"/>
                </attempt>
            </retry>

        </webhook>



<!--    4-->

    <webhookSession timeout="60s">
        <webhook>
            <receive expected="expected.json" forwardTo="API_WEBSITE_1"/>
            <responses idleTimeout="30s">
                <response expected="response.json" status="500" stub="modified_or_stub.json"/>
                <response expected="response.json" status="500" stub="modified_or_stub.json"/>
                <response expected="response.json" status="200" stub="modified_or_stub.json"/>
            </responses>
        </webhook>
    </webhookSession>




    <webhook timeout="60s">
        <receive expected="payment_event.json" forward="true" alias="PAYMENT_API"/>
        <response>
            <expected>
                <status>500</status>
                <file>expected.json</file>
                <headers></headers>
            </expected>
            <mockReturn>
                <status>500<status/>
                <file>mock.json<file/>
                <headers></headers>
            </mockReturn>
        </response>

        <retry min="1" max="5" idleTimeout="20s">
            <receive expected="payment_event.json" forwardTo="PAYMENT_API"/>
            <response expected="payment_already_processed.json" return="success.json"/>
        </retry>

        <noRetry timeout="20s"/>
    </webhook>

