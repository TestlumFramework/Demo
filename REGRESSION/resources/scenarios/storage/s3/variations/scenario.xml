<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <description>Variations S3 test: create bucket, upload file, verify upload, remove file and bucket using variations</description>
        <name>S3 Variations scenario</name>
    </overview>

    <settings truncateStorages="true">
        <variations>variations_s3.csv</variations>
        <tags>s3</tags>
    </settings>

    <s3 comment="{{create_bucket_comment}}" alias="S3_0">
        <bucket comment="Check ability to create bucket using variation variable 'variable_bucket'">
            <create>{{variable_bucket}}</create>
        </bucket>
    </s3>

    <s3 comment="{{upload_file_comment}}" alias="S3_0">
        <file comment="Check ability to upload 'variable_file' to 'variable_bucket'"
              bucket="{{variable_bucket}}"
              key="/testlum/{{variable_file}}">
            <upload>{{variable_file}}</upload>
        </file>
    </s3>

    <s3 comment="{{download_file_comment}}" alias="S3_0">
        <file comment="Check that downloaded file matches expected"
              bucket="{{variable_bucket}}"
              key="/testlum/{{variable_file}}">
            <download>
                <file>expected_{{variable_expected}}.json</file>
            </download>
        </file>
    </s3>

    <s3 comment="{{download_inline_comment}}" alias="S3_0">
        <file comment="Check that downloaded file matches expected"
              bucket="{{variable_bucket}}"
              key="/testlum/{{variable_file}}">
            <download>
                <value>{{content_expected}}</value>
            </download>
        </file>
    </s3>

    <s3 comment="Step 5 - remove file using file key and bucket" alias="S3_0">
        <file comment="Check ability to remove file from bucket"
              bucket="{{variable_bucket}}"
              key="/testlum/{{variable_file}}">
            <remove/>
        </file>
    </s3>

    <s3 comment="{{remove_bucket_comment}}" alias="S3_0">
        <bucket comment="Check ability to remove {{variable_bucket}} after all files are cleaned up">
            <remove>{{variable_bucket}}</remove>
        </bucket>
    </s3>

</scenario>
