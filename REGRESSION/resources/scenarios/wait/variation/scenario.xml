<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.knubisoft.com/testlum/testing/model/scenario"
          xsi:schemaLocation="http://www.knubisoft.com/testlum/testing/model/scenario scenario.xsd">

    <overview>
        <description>Self test for command: Wait with variations</description>
        <name>Wait with variations</name>
    </overview>

    <settings>
        <variations>wait_variations.csv</variations>
        <tags>wait</tags>
    </settings>

    <var comment="Create var with current time" name="currentTime">
        <expression value="T(java.lang.System).currentTimeMillis()"/>
    </var>

    <wait comment="{{comment}}" time="{{seconds}}"/>

    <var comment="Create var with updated time" name="updatedTime">
        <expression value="T(java.lang.System).currentTimeMillis()"/>
    </var>

    <var comment="Create var with diff between two times" name="diff">
        <expression
                value="T(java.lang.Long).parseLong('{{updatedTime}}') - T(java.lang.Long).parseLong('{{currentTime}}')"/>
    </var>

    <var comment="Create normalize var" name="normalizedSeconds">
        <expression value="T(java.lang.Math).round({{diff}} / 1000.0)"/>
    </var>

    <assert comment="Check actual diff between times">
        <equal comment="Ensure wait worked approximately">
            <content>{{normalizedSeconds}}</content>
            <content>{{seconds}}</content>
        </equal>
    </assert>

    <var comment="Create variable for injecting comment" name="commentVar">
        <constant value="Check that variable can be injected in attributes of wait command"/>
    </var>

    <var comment="Create variable for injecting time" name="timeVar">
        <constant value="1"/>
    </var>

    <wait comment="{{commentVar}}" time="{{timeVar}}"/>

</scenario>