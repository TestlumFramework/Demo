<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <description>This scenario verifies CSV-driven email command execution across multiple test data variations.</description>
        <name>Email Variation Test</name>
    </overview>

    <settings>
        <variations>email_variations.csv</variations>
        <tags>email</tags>
    </settings>

    <smtp comment="Send email for variation scenario run"
          alias="SMTP_0"
          recipientEmail="game_den@ukr.net">
        <subject>{{subject}}</subject>
        <text>{{body}}</text>
    </smtp>

    <email comment="{{comment}}"
           alias="EMAIL_0"
           pattern="{{pattern}}"
           timeout="25000"
           targetVariable="{{targetVar}}"/>

    <assert comment="Verify extracted value matches expected variation">
        <equal comment="Check targetVar matches expectedValue">
            <content>{{varOtp}}</content>
            <content>{{expectedValue}}</content>
        </equal>
    </assert>

</scenario>
