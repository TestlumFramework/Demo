<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <name>Web Ott Test with inline secret</name>
        <description>Verify Ott UI command generates code from inline secret inside a web session, without alias
        </description>
    </overview>

    <settings onlyThis="true">
        <tags>ottWeb</tags>
    </settings>

    <web comment="Start WEB script">

        <navigate comment="Navigate to UI Elements page"
                  command="to"
                  path="/ui-elements"/>

        <ott comment="Generate OTP code from inline secret inside web session" secret="JBSWY3DPEHPK3PXP"
             name="webSecretOtpCode"/>

    </web>

    <condition comment="Verify webSecretOtpCode has correct format" name="otpFormatCondition"
               spel="'{{webSecretOtpCode}}'.matches('^[0-9]{6}$')"/>

    <assert comment="Check that otpFormatCondition is true">
        <equal comment="Check that otpFormatCondition is true">
            <content>{{otpFormatCondition}}</content>
            <content>true</content>
        </equal>
    </assert>

</scenario>