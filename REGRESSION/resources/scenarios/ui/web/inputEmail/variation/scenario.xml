<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <name>InputEmail - Variations</name>
        <description>
            This scenario verifies inputEmail command using CSV variations.

            Test flow:
            1. Send verification email with variation data via SMTP.
            2. Include web login steps.
            3. Navigate to UI Elements page.
            4. Execute inputEmail with data rows from CSV.
            5. Verify entered value matches expected variation.

            This scenario validates:
            - CSV variation row injection
            - dynamic locator, pattern, and target variable
            - typing and DOM validation across variations
        </description>
    </overview>

    <settings>
        <variations>inputEmail_variations.csv</variations>
        <tags>web,email</tags>
    </settings>

    <include comment="Include login steps"
             scenario="/ui/includes/login_web/scenario.xml"/>

    <smtp comment="Send email for variation scenario iteration"
          alias="SMTP_0"
          recipientEmail="game_den@ukr.net">
        <subject>{{subject}}</subject>
        <text>{{body}}</text>
    </smtp>

    <web comment="Start WEB variations script">

        <navigate comment="Navigate to UI Elements page"
                  command="to"
                  path="/ui-elements"/>

        <wait comment="Wait for page load" time="2"/>

        <clear comment="Clear input field before variation iteration"
               locator="{{locator}}"/>

        <inputEmail comment="{{comment}}"
                    alias="EMAIL_0"
                    locator="{{locator}}"
                    pattern="{{pattern}}"
                    timeout="25000"
                    highlight="true"
                    targetVariable="{{targetVar}}"/>

        <assert comment="Verify input field contains the expected value">
            <attribute comment="Check input value matches expectedValue"
                       name="value"
                       locator="{{locator}}">
                <content>{{expectedValue}}</content>
            </attribute>
            <equal comment="Check target variable matches expectedValue">
                <content>{{currentVarResult}}</content>
                <content>{{expectedValue}}</content>
            </equal>
        </assert>

    </web>

</scenario>
