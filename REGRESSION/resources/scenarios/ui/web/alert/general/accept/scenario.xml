<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.knubisoft.com/testlum/testing/model/scenario"
          xsi:schemaLocation="http://www.knubisoft.com/testlum/testing/model/scenario scenario.xsd">

    <overview>
        <name>Alert - Accept</name>
        <description>
            This scenario verifies simple alert accept action.

            Test flow:
            1. Navigate to modal page.
            2. Trigger alert.
            3. Accept alert.

            This scenario validates:
            - alert appearance
            - accept action
        </description>
    </overview>

    <settings>
        <tags>web</tags>
    </settings>

    <include comment="Include login steps"
             scenario="/ui/includes/login_web/scenario.xml"/>

    <web comment="Start WEB script">

        <navigate comment="Navigate to modal page"
                  command="to"
                  path="/modal"/>

        <click comment="Trigger alert"
               locator="modal.alertBtn"/>

        <alert comment="Accept alert"
               action="accept"
               type="alert"
               waitUntilVisible="true"/>

    </web>

</scenario>