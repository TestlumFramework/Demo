<scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://www.testlum.com/testing/model/scenario"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <name>CryptoInput - General</name>
        <description>
            This scenario verifies cryptoInput command with encrypt and decrypt.

            Test flow:
            1. Navigate to UI Elements page.
            2. Encrypt and input value.
            3. Verify encrypted input.
            4. Decrypt a known encrypted value.
            5. Verify decrypted input.

            This scenario validates:
            - cryptoInput execution
            - encrypt behavior
            - decrypt behavior
        </description>
    </overview>

    <settings>
        <tags>customWeb</tags>
    </settings>

    <include comment="Include login steps"
             scenario="/ui/includes/login_web/scenario.xml"/>

    <var comment="Value to encrypt" name="defaultValue">
        <constant value="HELLO"/>
    </var>

    <var comment="Known encrypted value" name="encryptedValue">
        <constant value="azGkRZP0s47fzT1rJ28Cq1Lcsi0qiiu1c37k9NitOaOm"/>
    </var>

    <web comment="Start WEB script">

        <navigate comment="Navigate to UI Elements page"
                  command="to"
                  path="/ui-elements"/>

        <wait comment="Wait for page load"
              time="2"/>

        <cryptoInput comment="Input encrypted value"
                     locator="uiElements.hotKeyInput1"
                     locatorStrategy="locatorId">
            <encrypt alias="CRYPTO1"
                     value="{{defaultValue}}"/>
        </cryptoInput>

        <cryptoInput comment="Input decrypted value"
                     locator="uiElements.hotKeyInput2"
                     locatorStrategy="locatorId">
            <decrypt alias="CRYPTO1"
                     value="{{encryptedValue}}"/>
        </cryptoInput>

        <assert comment="Verify decrypted value">
            <attribute comment="Check decrypted value"
                       name="value"
                       locator="uiElements.hotKeyInput2">
                <content>{{defaultValue}}</content>
            </attribute>
        </assert>

    </web>

</scenario>

