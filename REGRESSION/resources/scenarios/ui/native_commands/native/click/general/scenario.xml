<scenario xmlns="http://www.testlum.com/testing/model/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.testlum.com/testing/model/scenario scenario.xsd">

    <overview>
        <description>Testing general Click tag</description>
        <name>Interactive Click Validation</name>
    </overview>

    <settings>
        <tags>native</tags>
    </settings>
  
    <native comment="Executing native automation sequence">
        <click comment="Clicking on button clickPage" locator="testApp.clickPage"/>
        
        <click comment="Clicking on button to increase counter" locator="testApp.clickButton"/>
        
        <assert comment="Validating expected UI state">
            <attribute comment="Retrieving element text attribute for validation"
                       locator="testApp.counter"
                       name="text">
                <content>Counter: 1</content>
            </attribute>
        </assert>
    </native>

</scenario>